{
  "name": "@captiveorigins/payload-plugin-whitehat",
  "version": "0.1.0",
  "description": "Whitehat for Payload: finds security holes in a Payload site, its database, code and UI, with severity-ranked alerts and a checklist that grows with every incident.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-whitehat#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-whitehat/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "security",
    "access-control",
    "vulnerability-scanner",
    "penetration-testing",
    "audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-whitehat.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHECKLIST.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
